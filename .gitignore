# 1) 일단 전부 무시
*
# 2) 디렉터리는 탐색 허용 (이게 없으면 아래 예외가 동작하지 않음)
!*/
# 3) .gitignore 자신은 추적
!.gitignore
# 4) 필요한 conf만 예외로 허용
!apps/*/local/inputs.conf
!apps/*/local/props.conf
!apps/*/local/transforms.conf
#!apps/*/default/inputs.conf
#!apps/*/default/props.conf
#!apps/*/default/transforms.conf
!system/local/inputs.conf
!system/local/props.conf
!system/local/transforms.conf
