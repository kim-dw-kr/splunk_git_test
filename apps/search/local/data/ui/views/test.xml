<dashboard version="1.1" theme="dark">
  <label>test</label>
  <row>
    <panel>
      <table>
        <title>bots</title>
        <search>
          <query>index=bots* earliest=0
| stats c by host sourcetype source
| sort limit=0 - c</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <table>
        <search>
          <query>| tstats c where index=bots* earliest=0 by sourcetype</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </table>
    </panel>
  </row>
</dashboard>