          <option name="drilldown">none</option>
        </table>
      </panel>
      <panel id="p15">
        <title>15. streamstats 누적 건수</title>
        <chart>
          <search>
            <query>index=$idx$ | streamstats count as running by sourcetype | stats max(running) as total by sourcetype | sort - total</query>
            <earliest>$tr.earliest$</earliest>
            <latest>$tr.latest$</latest>
            <progress><set token="s_p15">$job.sid$</set><set token="s_p15_st">RUNNING</set></progress>
