      </panel>
      <panel id="p14">
        <title>14. streamstats 이벤트 간격(초)</title>
        <table>
          <search>
            <query>index=$idx$ | sort 0 host _time | streamstats current=f last(_time) as prev by host | eval gap=_time-prev | stats avg(gap) max(gap) p95(gap) by host</query>
            <earliest>$tr.earliest$</earliest>
