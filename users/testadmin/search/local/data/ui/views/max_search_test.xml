  <row>
      <panel id="p16">
        <title>16. transaction host maxspan=1m</title>
        <table>
          <search>
            <query>index=$idx$ | transaction host maxspan=1m maxevents=500 | stats avg(eventcount) as avg_ev avg(duration) as avg_dur count by host</query>
            <earliest>$tr.earliest$</earliest>
            <latest>$tr.latest$</latest>
            <progress><set token="s_p16">$job.sid$</set><set token="s_p16_st">RUNNING</set></progress>
            <done><set token="s_p16_st">$job.dispatchState$</set><set token="s_p16_rd">$job.runDuration$</set><set token="s_p16_rc">$job.resultCount$</set></done>
