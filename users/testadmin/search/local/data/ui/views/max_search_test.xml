            <cancelled><set token="s_p12_st">CANCELLED</set></cancelled>
          </search>
          <option name="charting.chart">line</option>
          <option name="charting.legend.placement">bottom</option>
        </chart>
      </panel>
  </row>
  <row>
      <panel id="p13">
        <title>13. 1분 단위 timechart by sourcetype</title>
        <chart>
          <search>
            <query>index=$idx$ | timechart span=1m count by sourcetype limit=20</query>
            <earliest>$tr.earliest$</earliest>
            <latest>$tr.latest$</latest>
            <progress><set token="s_p13">$job.sid$</set><set token="s_p13_st">RUNNING</set></progress>
