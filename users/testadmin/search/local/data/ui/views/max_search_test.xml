            <cancelled><set token="sid_p24_state">CANCELLED</set></cancelled>
          </search>
          <option name="charting.chart">pie</option>
          <option name="charting.legend.placement">bottom</option>
        </chart>
      </panel>
  </row>
  <row>
      <panel id="p25">
        <title>25. 스케줄 검색 실행시간 상위</title>
